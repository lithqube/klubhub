{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@dev/dj",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "syncGenerators": [],
      "outputs": [],
      "options": {
        "command": "bash scripts/typecheck-phase5.sh",
        "cwd": ".",
        "envFile": "{workspaceRoot}/.env.example"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/dj/scripts/build-prod.mjs",
        "cwd": "."
      }
    }
  }
}
