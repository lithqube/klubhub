{
  "name": "site",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/site"],
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/apps/dj/app/assets/css/styles.css", "{workspaceRoot}/apps/dj/public/fonts/**/*"],
      "options": {"command": "node apps/site/build.mjs"}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {"command": "node --test apps/site/site.test.mjs"}
    },
    "test-responsive": {
      "executor": "nx:run-commands",
      "options": {"command": "node --test apps/site/responsive.test.mjs"}
    }
  }
}
