{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Nuxt Frontend (dj)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "dj"],
      "port": 4200
    },
    {
      "name": "Nuxt Frontend (dj, real backend)",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "NUXT_PUBLIC_API_BASE=http://127.0.0.1:8080 pnpm nx serve @dev/dj --host 0.0.0.0 --port 4200"
      ],
      "port": 4200
    },
    {
      "name": "KlubHub Site (static)",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "pnpm exec nx run site:build && python3 -m http.server 4300 --directory dist/site"
      ],
      "port": 4300
    },
    {
      "name": "KlubHub Site (review worktree)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4301", "--directory", "/Users/admin/dev/klubhub-dj-review/dist/site"],
      "port": 4301
    },
    {
      "name": "Nuxt Frontend (review worktree, mocks)",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/admin/dev/klubhub-dj-review && unset NUXT_PUBLIC_API_BASE && pnpm --config.verify-deps-before-run=false nx serve @dev/dj --port 4210"
      ],
      "port": 4210
    },
    {
      "name": "Go API",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/admin/dev/klubhub-dj/api && go run ./cmd/api"
      ],
      "port": 8080
    }
  ]
}
