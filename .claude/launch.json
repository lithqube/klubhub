{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Nuxt Frontend (dj)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "dj"],
      "port": 4200
    },
    {
      "name": "KlubHub Site (static)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4300", "--directory", "/Users/admin/dev/klubhub-dj/dist/site"],
      "port": 4300
    },
    {
      "name": "Go API",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/admin/dev/klubhub-dj/api && go run ./cmd/api"
      ],
      "port": 8080
    }
  ]
}
