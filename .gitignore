# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Backup archives
backups/*.tar.gz
backups/work-*/

# Loose archive artifacts at the repo root (e.g. ad-hoc zips of the project)
# Specific paths take precedence; *.zip at root only.
/*.zip

.nx/cache
.nx/workspace-data

# Nuxt dev/build outputs
.output
.output-demo
.data
.nuxt
.nuxt-demo
.nitro
.cache
vitest.config.*.timestamp*
test-output

.nx/polygraph
.claude/worktrees
.claude/settings.local.json
.env
.env.override
garage.toml

# Bind-mounted secrets for production compose (Plan C.3)
# Generated by the operator; never commit contents.
secrets/
secrets/*.txt

# Plunk secret key (sk_*). Mounted as a Docker secret in
# docker-compose*.yml so the API binary can read it via PLUNK_SECRET_KEY_FILE
# if/when server-side transactional email lands. Never commit contents.
plunk_secret_key
*.plunk_secret_key

# Transient dir created during Plan D production config evaluation in
# apps/dj/nuxt.config.ts. Moved back on build:done. Never commit.
apps/dj/.mock-api-v1/

# Local Go binary produced by `go build ./cmd/api/` from api/.
/api/api

# Generated TypeScript incremental build cache — not source, drifts on
# every local build.
apps/dj/tsconfig.tsbuildinfo

brag-output/
brag-output-*
.playwright-mcp/
