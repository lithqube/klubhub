# Non-secret single-node Garage v2.2 template, copied by scripts/setup.sh.
# RPC/admin secrets are mounted files selected by GARAGE_*_FILE in Compose.
metadata_dir = "/data/meta"
data_dir = "/data/storage"
db_engine = "sqlite"
replication_factor = 1
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"

[admin]
api_bind_addr = "[::]:3903"
