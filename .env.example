# KlubHub DJ — Environment Variables
# Copy to .env and fill in values before running docker compose up -d

# ── Required ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# GarageHQ S3 Storage (Phase 0.5 — replaces MinIO)
# Generate with: openssl rand -hex 32
S3_ACCESS_KEY=klubhub-access-key
S3_SECRET_KEY=changeme
S3_REGION=europe-west-1

# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Optional (defaults shown) ──────────────────────────────────────────
# Services bind to 127.0.0.1 by default. Change to 0.0.0.0 for remote access.
BIND_ADDRESS=127.0.0.1

# Base URL the Go API is reachable at from WITHIN the Docker network (frontend → api)
NUXT_PUBLIC_API_BASE=http://api:8080

# GarageHQ S3 endpoint (internal Docker network)
S3_ENDPOINT=storage:39000

# GarageHQ S3 URL reachable from the BROWSER (for presigned URLs)
S3_PUBLIC_ENDPOINT=http://127.0.0.1:39000
S3_BUCKET=klubhub

LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:3000

# ── Optional API Keys (cover art + social) ─────────────────────────────
# Leave blank to start without these integrations; health endpoint will show "unconfigured"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DISCOGS_API_KEY=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Backward Aliases (deprecated, use S3_* vars above) ────────────────
MINIO_ENDPOINT=${S3_ENDPOINT}
MINIO_ACCESS_KEY=${S3_ACCESS_KEY}
MINIO_SECRET_KEY=${S3_SECRET_KEY}
MINIO_REGION=${S3_REGION}
MINIO_PUBLIC_ENDPOINT=${S3_PUBLIC_ENDPOINT}
MINIO_BUCKET=${S3_BUCKET}
