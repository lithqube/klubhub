# KlubHub DJ — Environment Variables
# Copy to .env and fill in values before running docker compose up -d

# ── Required ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# Garage S3 Storage (the only supported object-storage service)
# Generate with: docker exec klubhub-storage /garage key create <name>
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=europe-west-1

# Garage secrets — generate with: openssl rand -hex 32 (rpc) and openssl rand -base64 32 (admin)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Calendar/PDF bearer token (gates calendar.ics and per-gig booking PDFs).
# Generate with: openssl rand -hex 32
ICAL_SECRET=

# ── Optional (defaults shown) ──────────────────────────────────────────
# Services bind to 127.0.0.1 by default. Change to 0.0.0.0 for remote access.
BIND_ADDRESS=127.0.0.1

# Base URL the Go API is reachable at from WITHIN the Docker network (frontend → api)
NUXT_PUBLIC_API_BASE=http://api:8080

# Garage S3 endpoint (internal Docker network)
S3_ENDPOINT=storage:39000

# Garage S3 URL reachable from the BROWSER (for presigned URLs)
S3_PUBLIC_ENDPOINT=http://127.0.0.1:39000
S3_BUCKET=klubhub

LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:3000

# ── Optional API Keys (cover art + social) ─────────────────────────────
# Leave blank to start without these integrations; health endpoint will show "unconfigured"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DISCOGS_API_KEY=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Optional: email (transactional + outreach) ───────────────────────────
# Transactional mail (invoice receipts, agreements) — works with hosted or
# self-hosted Plunk. Leave blank to disable; finance routes answer 503.
PLUNK_BASE_URL=
PLUNK_API_KEY=
PLUNK_FROM_EMAIL=
PLUNK_FROM_NAME=

# OUTREACH_PROVIDER_PERMITS_OUTREACH — REQUIRED before any booking
# request/offer can be sent. Booking outreach is cold B2B outreach: the
# recipient never opted in. Plunk's Terms of Service §5 ("NO COLD EMAILING
# POLICY") prohibits that outright, including via the transactional endpoint.
#
# Fail-closed: "false" (the default) makes both send paths answer
# 422 outreach_not_permitted. Set "true" ONLY if your provider's terms permit
# it — a self-hosted Plunk you control, or a provider allowing opted-out B2B
# under a documented lawful basis. Reads and finance email are unaffected.
#
# Setting this attests a provider decision; it is not a compliance
# certificate. You remain responsible for lawful basis, opt-out handling and
# CAN-SPAM/GDPR/CASL compliance. Full guidance: docs/OUTREACH-PROVIDER.md
OUTREACH_PROVIDER_PERMITS_OUTREACH=false
# Per-day outreach cap per tenant (failed attempts count). Bounds blast
# radius when the API is exposed — it is not a substitute for auth.
OUTREACH_MAX_PER_DAY=50
# Fills the {{epk_link}} template variable.
EPK_PUBLIC_URL=

# ── Switchable features (docs/EDITIONS.md) ─────────────────────────────
# Prod compose forwards this to both the API (FEATURE_RA_IMPORT) and the UI
# (NUXT_PUBLIC_FEATURES_RA_IMPORT).
# Resident Advisor import (EPK artist import + gig event import) is part of
# the open-source build and on by default. Set false to hide and disable it.
FEATURE_RA_IMPORT=true
