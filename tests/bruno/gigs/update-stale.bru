meta {
  name: Update gig rejects stale updated_at (optimistic concurrency)
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/v1/gigs/{{createdGigId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "venue": "Stale Write",
    "updated_at": "2020-01-01T00:00:00Z"
  }
}

assert {
  res.status: eq 409
}
