meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains application/json
  res.body.integrations.database.status: eq ok
  res.body.integrations.storage.status: eq ok
}
