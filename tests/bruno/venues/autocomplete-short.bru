meta {
  name: Venue autocomplete ignores single-character queries
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/venues/autocomplete?q=B
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  if (!Array.isArray(body) || body.length !== 0) {
    throw new Error("single-character query should return an empty array");
  }
}
