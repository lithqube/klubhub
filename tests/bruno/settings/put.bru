meta {
  name: Update settings
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/settings
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "dj_name": "Test DJ",
    "timezone": "Europe/Berlin"
  }
}

assert {
  res.status: eq 200
}
