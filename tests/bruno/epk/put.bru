meta {
  name: Update EPK content
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/epk/content
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "bio_short": "Updated bio",
    "bio_long": "Long bio"
  }
}

assert {
  res.status: eq 200
}
