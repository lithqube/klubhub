meta {
  name: A new staff PIN clears the lock
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/door/events/{{lockEventId}}/pin
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "valid_until": "{{pinValidUntil}}"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("new 6-digit PIN", function () {
    const pin = res.getBody().pin;
    expect(pin).to.match(/^\d{6}$/);
    bru.setVar("lockPin", pin);
  });
}
