meta {
  name: 5th wrong PIN locks the staff PIN (429 pin_locked)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/door/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "device_token": "{{deviceToken}}",
    "event_id": "{{lockEventId}}",
    "pin": "{{lockWrongPin}}"
  }
}

script:pre-request {
  // Wrong tries 1-4 go out from here (node http, same CSRF headers as the
  // collection); this request is the 5th.
  const http = require("http");
  const url = bru.getEnvVar("baseUrl") + "/api/v1/door/login";
  const body = JSON.stringify({ device_token: bru.getVar("deviceToken"), event_id: bru.getVar("lockEventId"), pin: bru.getVar("lockWrongPin") });
  const post = () => new Promise((resolve, reject) => {
    const r = http.request(url, {
      method: "POST",
      headers: { "Content-Type": "application/json", "Content-Length": Buffer.byteLength(body), Origin: bru.getEnvVar("origin"), "X-KlubHub-CSRF": "1" },
    }, (resp) => {
      resp.resume();
      resp.on("end", () => resolve(resp.statusCode));
    });
    r.on("error", reject);
    r.end(body);
  });
  const codes = [];
  for (let i = 0; i < 4; i++) codes.push(await post());
  bru.setVar("lockEarlierCodes", codes.join(","));
}

assert {
  res.status: eq 429
  res.body.error: eq pin_locked
  res.body.retry_after: isString
}

tests {
  test("tries 1-4 were plain 401s", function () {
    expect(bru.getVar("lockEarlierCodes")).to.equal("401,401,401,401");
  });
  test("Retry-After in seconds, about 15 minutes, and no session cookie", function () {
    const secs = Number(res.getHeader("retry-after"));
    expect(secs).to.be.within(1, 900);
    expect(secs).to.be.above(800);
    expect(Date.parse(res.getBody().retry_after)).to.be.above(Date.now());
    const sc = [].concat(res.getHeader("set-cookie") || []);
    expect(sc.some((c) => c.startsWith("__Host-kh_session="))).to.equal(false);
  });
}
