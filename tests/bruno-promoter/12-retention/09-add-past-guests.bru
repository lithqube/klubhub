meta {
  name: Add guests to the past event
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/events/{{pastEventId}}/guests
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "list_id": "{{pastListId}}",
    "guests": [
      { "name": "Past Guest", "email": "past.guest@example.org", "phone": "+49 30 7654321", "note": "left early", "plus_n": 1, "status": "going" },
      { "name": "Other Past", "status": "pending" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.added.length: eq 2
}
