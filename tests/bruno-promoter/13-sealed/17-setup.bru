meta {
  name: Set up sealed data (owner + recovery wraps)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/keys/org/setup
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "version": 1,
    "recovery": { "public_key": "{{recoveryPub1}}", "fingerprint": "{{recoveryFp1}}", "wrap": "{{recoveryWrap1}}" },
    "wraps": [
      { "recipient_kind": "member", "recipient_id": "{{ownerUserId}}", "wrap": "{{ownerWrap1}}" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq ready
  res.body.version: eq 1
  res.body.my_wrap: eq {{ownerWrap1}}
  res.body.recovery_fingerprint: eq {{recoveryFp1}}
}
