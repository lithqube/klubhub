meta {
  name: Ban entry under a stale key version is 409
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/v1/ban-list
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "id": "{{banIdStale}}",
    "key_version": 2,
    "entry_sealed": "{{entry2}}",
    "expires_at": "{{banExpires}}"
  }
}

script:pre-request {
  bru.setVar("banIdStale", require("crypto").randomUUID());
}

assert {
  res.status: eq 409
  res.body.error: eq key_version_stale
}
