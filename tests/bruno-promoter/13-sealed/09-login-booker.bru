meta {
  name: Booker logs in
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "booker@example.org",
    "password": "booker sealed passphrase"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("booker session cookie", function () {
    const sc = [].concat(res.getHeader("set-cookie") || []);
    const raw = sc.find((c) => c.startsWith("__Host-kh_session="));
    expect(raw).to.be.a("string");
    bru.setVar("bookerCookie", /^__Host-kh_session=([^;]+)/.exec(raw)[1]); // secret: runtime only
  });
}
