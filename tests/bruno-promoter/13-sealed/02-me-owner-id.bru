meta {
  name: Owner user id (for member removal)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
}

assert {
  res.status: eq 200
  res.body.mfa: eq true
}

tests {
  test("owner sub is local", function () {
    const sub = res.getBody().sub;
    expect(sub).to.match(/^local:[0-9a-f-]{36}$/);
    bru.setVar("ownerUserId", sub.slice("local:".length));
  });
}
