meta {
  name: Re-provision the device for version 2
  type: http
  seq: 53
}

put {
  url: {{baseUrl}}/api/v1/keys/devices/{{sealedDeviceId}}/wrap
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "wrap": "{{deviceWrap2}}",
    "version": 2
  }
}

assert {
  res.status: eq 200
  res.body.version: eq 2
}
