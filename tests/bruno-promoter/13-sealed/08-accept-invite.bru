meta {
  name: Booker accepts the invite
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/invites/accept
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{bookerInvite}}",
    "display_name": "Bruno Booker",
    "password": "booker sealed passphrase"
  }
}

assert {
  res.status: eq 204
}
