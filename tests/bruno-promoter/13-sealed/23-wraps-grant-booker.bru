meta {
  name: Grant the booker access
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/keys/org/wraps
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "version": 1,
    "wraps": [
      { "recipient_kind": "member", "recipient_id": "{{bookerUserId}}", "wrap": "{{bookerWrap1}}" }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.version: eq 1
  res.body.added: eq 1
}
