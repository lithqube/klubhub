meta {
  name: Ban list has the updated entry
  type: http
  seq: 37
}

get {
  url: {{baseUrl}}/api/v1/ban-list
  body: none
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
}

assert {
  res.status: eq 200
  res.body.entries: length 1
  res.body.entries[0].id: eq {{banId1}}
  res.body.entries[0].entry_sealed: eq {{entry1b}}
}

tests {
  test("each entry says who added it (created_by_name)", function () {
    const e = res.getBody().entries[0];
    expect(e).to.have.property("created_by_name");
    expect(e.created_by_name).to.be.a("string").and.not.equal("");
    expect(e.created_by_name).to.equal(bru.getVar("ownerName"));
  });
}
