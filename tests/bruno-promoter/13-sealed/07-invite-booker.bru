meta {
  name: Invite a booker (MFA session)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/members/invites
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "email": "booker@example.org",
    "role": "booker"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("invite token returned once", function () {
    const tok = res.getBody().invite_token;
    expect(tok).to.match(/^v1\./);
    bru.setVar("bookerInvite", tok); // secret: runtime only
  });
}
