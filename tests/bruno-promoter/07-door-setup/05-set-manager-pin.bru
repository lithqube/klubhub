meta {
  name: Generate the manager PIN
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/door/events/{{eventId}}/pin
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "valid_until": "{{pinValidUntil}}",
    "manager": true
  }
}

assert {
  res.status: eq 201
  res.body.manager: eq true
}

tests {
  test("manager PIN is 6 digits", function () {
    const pin = res.getBody().pin;
    expect(pin).to.match(/^\d{6}$/);
    bru.setVar("managerPin", pin); // secret: runtime only
    bru.setVar("wrongManagerPin", String((Number(pin) + 1) % 1000000).padStart(6, "0"));
  });
}
