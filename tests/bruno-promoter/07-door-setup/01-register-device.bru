meta {
  name: Register a door device
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/door/devices
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "label": "Bruno door phone"
  }
}

assert {
  res.status: eq 201
  res.body.label: eq Bruno door phone
}

tests {
  test("device token is returned once", function () {
    const b = res.getBody();
    expect(b.id).to.match(/^[0-9a-f-]{36}$/);
    expect(b.token).to.match(/^v1\.[0-9a-f-]{36}\.[A-Za-z0-9_-]{43}$/);
    bru.setVar("deviceId", b.id);
    bru.setVar("deviceToken", b.token); // secret: runtime only
  });
}
