meta {
  name: Register device without a label is 400
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/door/devices
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "label": "   "
  }
}

assert {
  res.status: eq 400
  res.body.error: eq invalid_input
}
