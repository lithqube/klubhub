meta {
  name: Password-only login now answers totp_required
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq totp_required
}

tests {
  test("no session cookie without the second factor", function () {
    const sc = [].concat(res.getHeader("set-cookie") || []);
    expect(sc.some((c) => c.startsWith("__Host-kh_session="))).to.equal(false);
  });
}
