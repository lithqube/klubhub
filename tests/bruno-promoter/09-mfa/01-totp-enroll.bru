meta {
  name: Enroll TOTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/totp/enroll
  body: none
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
}

assert {
  res.status: eq 200
  res.body.otpauth_uri: isString
}

tests {
  test("otpauth URI is SHA1 / 6 digits / 30s with a base32 secret", function () {
    const uri = res.getBody().otpauth_uri;
    expect(uri).to.match(/^otpauth:\/\/totp\//);
    // No WHATWG URL in the bru sandbox: parse the query by hand.
    const q = {};
    uri.split("?")[1].split("&").forEach((kv) => {
      const [k, v] = kv.split("=");
      q[decodeURIComponent(k)] = decodeURIComponent(v || "");
    });
    expect(q.algorithm).to.equal("SHA1");
    expect(q.digits).to.equal("6");
    expect(q.period).to.equal("30");
    expect(q.secret).to.match(/^[A-Z2-7]+=*$/);
    bru.setVar("totpSecret", q.secret); // secret: runtime only
  });
}
