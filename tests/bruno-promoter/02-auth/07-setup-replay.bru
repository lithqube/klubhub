meta {
  name: Setup link is single use
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/setup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{setupToken}}",
    "password": "{{ownerPassword}}"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq invalid_link
}
