meta {
  name: Forged session cookie is 401
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/org
  body: none
  auth: none
}

headers {
  Cookie: __Host-kh_session=v1.00000000-0000-0000-0000-000000000001.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
}

assert {
  res.status: eq 401
  res.body.error: eq unauthenticated
}
