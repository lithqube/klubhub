meta {
  name: Login with a wrong password is 401
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "definitely-not-the-password"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq invalid_credentials
}

tests {
  test("no session cookie is issued", function () {
    const sc = [].concat(res.getHeader("set-cookie") || []);
    expect(sc.some((c) => c.startsWith("__Host-kh_session="))).to.equal(false);
  });
}
