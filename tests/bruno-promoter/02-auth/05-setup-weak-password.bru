meta {
  name: Setup with a weak password is 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/setup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{setupToken}}",
    "password": "short"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq weak_password
}
