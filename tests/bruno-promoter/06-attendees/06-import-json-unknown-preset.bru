meta {
  name: JSON import with an unknown preset is 422
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/events/{{eventId}}/attendees/import
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "preset": "eventbrite",
    "rows": [{ "Order ID": "X-1", "Name": "Row Test" }]
  }
}

assert {
  res.status: eq 422
  res.body.error: eq invalid
  res.body.field: eq preset
}
