meta {
  name: Adding the same email again is skipped as duplicate
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/events/{{eventId}}/guests
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "list_id": "{{vipListId}}",
    "guests": [
      { "name": "Ada Again", "email": "ADA.test@example.org", "status": "going" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.added.length: eq 0
  res.body.duplicates[0]: eq 0
}
