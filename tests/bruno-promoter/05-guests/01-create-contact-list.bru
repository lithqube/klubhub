meta {
  name: Create VIP list (collects contact details)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/events/{{eventId}}/lists
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{staffCookie}}
  Content-Type: application/json
}

body:json {
  {
    "name": "VIP",
    "type": "vip",
    "collect_contact": true,
    "entry_terms": { "price_mode": "free", "perks": ["Coat Check", "coat check"] }
  }
}

assert {
  res.status: eq 201
  res.body.name: eq VIP
  res.body.type: eq vip
  res.body.collect_contact: eq true
  res.body.event_id: eq {{eventId}}
}

tests {
  test("perks are normalised and de-duplicated", function () {
    expect(res.getBody().entry_terms.perks).to.deep.equal(["coat check"]);
    bru.setVar("vipListId", res.getBody().id);
  });
}
