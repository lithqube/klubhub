meta {
  name: Door principal is event-scoped
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Cookie: __Host-kh_session={{doorCookie}}
}

assert {
  res.status: eq 200
  res.body.event_scope: eq {{eventId}}
  res.body.sub: eq device:{{deviceId}}
}

tests {
  test("only the door role", function () {
    expect(res.getBody().roles).to.deep.equal(["door"]);
  });
}
