meta {
  name: Door session cannot export the guest CSV (403)
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/events/{{eventId}}/guests/export.csv
  body: none
  auth: none
}

headers {
  Cookie: __Host-kh_session={{doorCookie}}
}

assert {
  res.status: eq 403
  res.body.error: eq no_role_grant
}
