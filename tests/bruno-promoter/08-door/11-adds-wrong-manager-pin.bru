meta {
  name: On-the-spot add with a wrong manager PIN is rejected
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/door/adds
  body: json
  auth: none
}

headers {
  Cookie: __Host-kh_session={{doorCookie}}
  Content-Type: application/json
}

body:json {
  {
    "adds": [
      { "id": "{{addIdWrong}}", "nonce": "bru-add-wrong-{{runTag}}", "list_id": "{{vipListId}}", "name": "Walk Up Wrong", "plus_n": 0, "manager_pin": "{{wrongManagerPin}}", "at": "{{opAt}}" }
    ]
  }
}

script:pre-request {
  bru.setVar("addIdWrong", require("crypto").randomUUID());
}

assert {
  res.status: eq 200
  res.body.results[0].status: eq rejected
  res.body.results[0].error: eq manager_pin_invalid
}
